{
  "$defs": {
    "FailureInfo": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "title": "Category",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "integration_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Integration Id"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "safe_message": {
          "title": "Safe Message",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "tenant_id": {
          "minLength": 1,
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "category",
        "safe_message"
      ],
      "title": "FailureInfo",
      "type": "object"
    },
    "ResourceUsage": {
      "additionalProperties": false,
      "properties": {
        "cpu_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu Seconds"
        },
        "peak_memory_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Peak Memory Bytes"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "stderr_bytes": {
          "default": 0,
          "minimum": 0,
          "title": "Stderr Bytes",
          "type": "integer"
        },
        "stdout_bytes": {
          "default": 0,
          "minimum": 0,
          "title": "Stdout Bytes",
          "type": "integer"
        },
        "tenant_id": {
          "minLength": 1,
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id"
      ],
      "title": "ResourceUsage",
      "type": "object"
    },
    "ScanStatus": {
      "enum": [
        "pending",
        "queued",
        "running",
        "completed",
        "failed",
        "cancelled",
        "timed-out",
        "partially-completed"
      ],
      "title": "ScanStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "correlation_id": {
      "title": "Correlation Id",
      "type": "string"
    },
    "duration_seconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration Seconds"
    },
    "failure": {
      "anyOf": [
        {
          "$ref": "#/$defs/FailureInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "idempotency_key": {
      "title": "Idempotency Key",
      "type": "string"
    },
    "integration_id": {
      "title": "Integration Id",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "resource_usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResourceUsage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "scan_id": {
      "title": "Scan Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Revision"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "status": {
      "$ref": "#/$defs/ScanStatus"
    },
    "tenant_id": {
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    },
    "tool_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool Version"
    }
  },
  "required": [
    "tenant_id",
    "scan_id",
    "project_id",
    "integration_id",
    "status",
    "correlation_id",
    "idempotency_key"
  ],
  "title": "ScanExecution",
  "type": "object"
}
