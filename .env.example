# Runtime mode: development, test, or production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Replace every example credential before using a shared or production environment.
POSTGRES_USER=chainguard
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=chainguard
REDIS_PASSWORD=change-this-local-redis-password

API_PORT=8000
UI_PORT=3000
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_BYTES=536870912
SCAN_TIMEOUT_SECONDS=900

DTRACK_POSTGRES_USER=dtrack
DTRACK_POSTGRES_PASSWORD=change-this-local-dtrack-password
DTRACK_POSTGRES_DB=dtrack
DTRACK_API_PORT=8082
DTRACK_UI_PORT=8081
DTRACK_PUBLIC_API_URL=http://localhost:8082
DTRACK_CORS_ORIGIN=http://localhost:8081

# Create an API key in Dependency-Track and add it here to enable automatic BOM upload.
# The stack remains functional without it; inspection results stay in ChainGuard.
DEPENDENCY_TRACK_API_KEY=
